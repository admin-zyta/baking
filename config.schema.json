{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Opus-Sonnet Router Config",
  "type": "object",
  "properties": {
    "bakingVersion": {
      "type": "string",
      "description": "Baking semver (must match VERSION in repo)."
    },
    "language": {
      "type": "string",
      "enum": ["en"],
      "default": "en",
      "description": "Documentation and orchestrator copy language (English only for now)."
    },
    "enabled": {
      "type": "boolean",
      "description": "Enables the automatic gate (single global config)."
    },
    "autoRoute": {
      "type": "object",
      "description": "When enabled: Baking on code requests without explicit /baking (toggle: baking auto-route on|off)",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "profile": {
      "type": "string",
      "enum": ["claude", "cursor", "hybrid"],
      "description": "Model profile: claude | cursor | hybrid"
    },
    "profiles": {
      "type": "object",
      "description": "Profile map (global config only)"
    },
    "handoffDir": {
      "type": "string",
      "description": "Diary folder relative to project root."
    },
    "filenamePattern": {
      "type": "string",
      "description": "Filename pattern: YYYY-MM-DD-<slug>.md"
    },
    "planner": {
      "type": "object",
      "properties": {
        "subagent": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "plannerHyper": {
      "type": "object",
      "properties": {
        "subagent": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "executor": {
      "type": "object",
      "properties": {
        "subagent": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "orchestrator": {
      "type": "object",
      "properties": {
        "recommendedModels": { "type": "array", "items": { "type": "string" } },
        "neverUseOpusAsParent": { "type": "boolean" }
      }
    },
    "routing": {
      "type": "object",
      "properties": {
        "defaultOnAmbiguity": { "enum": ["PLAN", "EXECUTE"] },
        "forcePlanIfNoHandoffExists": { "type": "boolean" }
      }
    },
    "consumption": {
      "type": "object",
      "properties": {
        "maxParallelSubagents": { "type": "integer", "minimum": 1 },
        "requireHandoffFile": { "type": "boolean" },
        "skipPlannerForTrivialTasks": { "type": "boolean" },
        "trivialTaskMaxWords": { "type": "integer" }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "dir": { "type": "string" },
        "file": { "type": "string" },
        "review": {
          "type": "object",
          "description": "Review cycle: intervalDays OR minRuns (see METRICS.md)",
          "properties": {
            "intervalDays": { "type": "integer", "minimum": 1 },
            "minRuns": { "type": "integer", "minimum": 1 },
            "routingAuditSample": { "type": "integer", "minimum": 1 },
            "routingMaxBadPct": { "type": "number", "minimum": 0 },
            "savingsMinPairs": { "type": "integer", "minimum": 0 },
            "savingsMinPct": { "type": "number" }
          }
        }
      }
    },
    "lightStack": {
      "type": "object",
      "description": "Light stack: Engram + verify + skill registry (see LIGHT-STACK.md)",
      "properties": {
        "enabled": { "type": "boolean" },
        "memory": { "type": "object" },
        "verify": { "type": "object" },
        "skillRegistry": { "type": "object" }
      }
    },
    "initMemory": {
      "type": "object",
      "properties": {
        "agentsFile": { "type": "string" },
        "projectRuleFile": { "type": "string" },
        "scanDir": { "type": "string" }
      }
    }
  }
}
